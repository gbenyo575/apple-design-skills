{
  "expo": {
    "name": "Zyora",
    "slug": "zyora-mobile-mvp",
    "version": "0.5.0",
    "orientation": "portrait",
    "icon": "./assets/zyora-icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "cc.zyora.mvp",
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0C12"
      },
      "package": "cc.zyora.mvp"
    },
    "web": {
      "favicon": "./assets/zyora-icon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-sharing",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/zyora-icon.png",
          "backgroundColor": "#0D0C12",
          "imageWidth": 200
        }
      ],
      "expo-router"
    ],
    "scheme": "zyora"
  }
}
